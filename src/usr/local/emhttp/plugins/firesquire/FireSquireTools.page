Menu="Utilities"
Title="FireSquire"
Icon="firesquire.png"
---
<style>
/* The banner over the page, drawn alike on TowerTorch's and ShipLog's settings
   pages: the logo, the name and the claim on a card surface, and the logo again
   at the end as a faint silhouette cut by the edge, as wide as ShipLog's tab
   column and cards together. The silhouette rests grey and takes the colour
   while the pointer or the focus is on the banner: Unraid's red without
   TowerTorch, the accent or the first rainbow position with it. */
.fs-hero {
  --fs-hero-tint: #e22828;
  --fs-hero-dim: var(--alt-text-color, #8d8d8d);
  --fs-hero-sil: 16%;
  position: relative; isolation: isolate; overflow: hidden; box-sizing: border-box;
  display: flex; align-items: center; gap: 24px;
  max-width: 1148px; height: 136px; margin: 4px 0 32px; padding: 0 32px;
  border-radius: 4px;
  background: var(--mild-background-color, rgba(128, 128, 128, .08));
}
/* A faint colour over a white ground needs more of itself to show. */
html:is(.Theme--white, .Theme--azure) .fs-hero { --fs-hero-sil: 30%; }
.fs-hero-mark {
  position: absolute; z-index: -1; inset-inline-end: -44px; top: 50%; translate: 0 -50%;
  width: 264px; height: 264px; pointer-events: none;
  background-color: color-mix(in srgb, var(--fs-hero-dim) var(--fs-hero-sil), transparent);
  -webkit-mask: url(/plugins/firesquire/images/firesquire.png) center / contain no-repeat;
  mask: url(/plugins/firesquire/images/firesquire.png) center / contain no-repeat;
}
.fs-hero:is(:hover, :focus-within) .fs-hero-mark { background-color: color-mix(in srgb, var(--fs-hero-tint) var(--fs-hero-sil), transparent); }
@media (prefers-reduced-motion: no-preference) {
  .fs-hero-mark { transition: background-color var(--cc-motion-control-dur, 150ms); }
}
.fs-hero-logo { flex: none; display: block; width: 88px; height: 88px; object-fit: contain; }
/* The text stops short of the silhouette. */
.fs-hero-text { min-width: 0; max-width: calc(100% - 332px); }
.fs-hero .fs-hero-name {
  margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-family: inherit; font-size: 32px; font-weight: 700; line-height: 1.15; letter-spacing: normal; text-transform: none; color: inherit;
}
.fs-hero .fs-hero-claim {
  margin: 4px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: var(--cc-text-title, 16px); line-height: 1.45; text-align: start; color: var(--fs-hero-dim);
}
html.cc-popups-on .fs-hero {
  --fs-hero-tint: var(--fs-hero-rb, var(--cc-accent, #FCC419));
  --fs-hero-dim: var(--cc-text-dim, #8a8a8a);
  border-radius: var(--cc-radius-card, 20px);
  background: var(--cc-fm-card, var(--cc-surface-2, #222));
  color: var(--cc-text, #e6e6e6);
}
@media (max-width: 1023px) {
  .fs-hero { gap: 16px; height: 104px; padding: 0 20px; }
  .fs-hero-mark { inset-inline-end: -36px; width: 208px; height: 208px; }
  .fs-hero-logo { width: 64px; height: 64px; }
  .fs-hero-text { max-width: calc(100% - 260px); }
  .fs-hero .fs-hero-name { font-size: 26px; }
}
/* TowerTorch styles Unraid's title strip with !important, which only an
   important rule in a layer outranks. The banner names the page, so the strip
   would say it twice. */
@layer firesquire-settings {
  .content:has(> #ss-tools) > div.title { display: none !important; }
}
</style>
<div class="fs-hero">
  <span class="fs-hero-mark" aria-hidden="true"></span>
  <img class="fs-hero-logo" src="/plugins/firesquire/images/firesquire.png" alt="">
  <div class="fs-hero-text">
    <h1 class="fs-hero-name">FireSquire</h1>
    <p class="fs-hero-claim">Reads the beacon before your reboot catches fire.</p>
  </div>
</div>
<div id="ss-tools" style="max-width:780px;line-height:1.55"></div>
